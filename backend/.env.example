# ── PostgreSQL (Supabase connection string) ───────────────────────────────────
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-super-secret-key-at-least-32-chars
JWT_EXPIRE_HOURS=24

# ── Admin ─────────────────────────────────────────────────────────────────────
# Hash: python -c "import bcrypt; print(bcrypt.hashpw(b'tu_password', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$placeholder.replace.this.with.real.bcrypt.hash

# ── Supabase Storage ──────────────────────────────────────────────────────────
USE_SUPABASE_STORAGE=true
SUPABASE_STORAGE_BUCKET=vouchers

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
